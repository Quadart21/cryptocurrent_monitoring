# GapSnap — Apache .htaccess
# Нужен, только если фронт — Apache (mod_rewrite, mod_headers, mod_ssl, желательно mod_proxy).
# На nginx + PM2 этот файл НЕ читается: правила уже в nginx / next.config.ts.
#
# Куда положить:
#   DocumentRoot сайта → скопируйте как /.htaccess
#   или: cp deploy/.htaccess /var/www/gapsnap-public/.htaccess
#
# Требует AllowOverride All (или FileInfo/Options) в VirtualHost.

Options -Indexes -MultiViews
ServerSignature Off

RewriteEngine On

# ——— HTTPS ———
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ——— www → apex (gapsnap.org) ———
RewriteCond %{HTTP_HOST} ^www\.gapsnap\.org$ [NC]
RewriteRule ^ https://gapsnap.org%{REQUEST_URI} [L,R=301]

# ——— Блокировка служебных путей ———
RedirectMatch 404 /\.git
RedirectMatch 404 /\.env
RedirectMatch 404 /\.cursor
RedirectMatch 404 /node_modules
RedirectMatch 404 /drizzle
RedirectMatch 404 /scripts

<FilesMatch "(^\.env|\.env\..*|package(-lock)?\.json|composer\.(json|lock)|yarn\.lock|pnpm-lock\.yaml|tsconfig\.json|next\.config\.(js|ts|mjs))$">
  Require all denied
</FilesMatch>

# ——— Прокси на Next.js (PM2, порт 3000) ———
# Раскомментируйте блок, если Apache — входная точка, а Next слушает localhost:3000.
# <IfModule mod_proxy.c>
#   ProxyPreserveHost On
#   RequestHeader set X-Forwarded-Proto "https" env=HTTPS
#   ProxyPass        / http://127.0.0.1:3000/
#   ProxyPassReverse / http://127.0.0.1:3000/
# </IfModule>

# ——— Заголовки безопасности (согласованы с next.config.ts) ———
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://mc.yandex.ru https://yandex.ru; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru; frame-src 'self' https://www.googletagmanager.com https://mc.yandex.ru; upgrade-insecure-requests"
  Header always unset X-Powered-By

  # Не кешировать HTML у CDN/браузера агрессивно (динамический мониторинг)
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ——— Gzip ———
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ——— Brotli (если установлен mod_brotli) ———
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ——— Кеш статики ———
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/font-woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2?|png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

# MIME
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/javascript .mjs
</IfModule>
