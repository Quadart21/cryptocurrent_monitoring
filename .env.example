DATABASE_URL=postgresql://gapsnap:gapsnap@localhost:5432/gapsnap

# --- Multi-server roles (default: all = monolith) ---
# web    = public face (pages + APIs, no pollers)
# worker = pollers + heavy sync (keep off the public internet)
# all    = single-node (backwards compatible)
# GAPSNAP_ROLE=all
#
# On web node, forward admin sync / feed / news / banners / achievements to worker:
# WORKER_URL=http://10.0.0.2:3001
# WORKER_INTERNAL_SECRET=change-me-long-random-shared-secret
#
# On worker, push mirrored news covers to the public web node:
# WEB_INTERNAL_URL=http://10.0.0.1:3000
#
# Migrations on boot: web+all by default. Force on worker with:
# GAPSNAP_RUN_MIGRATIONS=1

BESTCHANGE_API_KEY=
BESTCHANGE_API_BASE=https://bestchange.app
# Интервал проверки новых кодов валют (по умолчанию 12ч).
# Новые валюты/города/страны только в очередь модерации, не в каталог автоматически.
# CATALOG_SYNC_INTERVAL_MS=43200000

# Обязательно смените в production
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
SESSION_SECRET=change-me-to-at-least-24-random-chars
# Email для алертов (баннер не найден на сайте обменника и т.п.)
ADMIN_ALERT_EMAIL=admin@example.com
# Интервал проверки баннеров на сайтах обменников (по умолчанию 24ч)
# BANNER_CHECK_INTERVAL_MS=86400000
# Секретный URL админки. Не указывайте его в robots.txt и публичных README.
# ADMIN_PATH=/ops-k7m2xq

# Публичный URL сайта (для ссылок в письмах)
SITE_URL=https://example.com

# Feed poller (worker / all)
# FEED_SYNC_INTERVAL_MS=60000
# FEED_SYNC_CONCURRENCY=6
# FEED_PROXY_MODE=auto
# FEED_PROXY_ATTEMPTS=24
# FEED_PARTNER_CODE=gapsnap

# codex.sale — AI-рерайт новостей для /blog
CODEX_API_KEY=
# или CODEX_LB_API_KEY=
CODEX_API_BASE=https://codex.sale/v1
# Прокси-пул лучше править в админке (Новости → Прокси-пул).
# Env используется только как fallback / первичный backfill:
# CODEX_PROXY_USER=
# CODEX_PROXY_PASS=
# CODEX_PROXY_PORT=7165
# NEWS_SYNC_INTERVAL_MS=86400000
# NEWS_SYNC_BATCH_SIZE=50
# NEWS_SYNC_PAUSE_MS=1500

# SMTP API — подтверждение отзывов / жалоб / писем владельцам
# SMTPBZ_API_KEY=
# SMTPBZ_FROM=noreply@example.com
# SMTPBZ_FROM_NAME=GapSnap

# Telegram-канал — лучше настроить в админке (Контент → Telegram).
# Env используется только как fallback / первичный backfill:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=@your_channel_or_-100...

# Cloudflare Turnstile (кабинет /cabinet)
# Создайте виджет в Cloudflare Turnstile.
# Для локальной разработки можно взять тестовые ключи Always Pass:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Опционально: разрешённые hostname из siteverify (через запятую)
# TURNSTILE_HOSTNAMES=example.com,www.example.com,localhost

# Application DoS limits (requests per IP per minute)
RATE_LIMIT_API_PER_MIN=180
RATE_LIMIT_AUTH_PER_MIN=8
RATE_LIMIT_WRITE_PER_MIN=12
RATE_LIMIT_TRACK_PER_MIN=90
RATE_LIMIT_SEARCH_PER_MIN=40
RATE_LIMIT_SYNC_PER_MIN=4
