DATABASE_URL=postgresql://gapsnap:gapsnap@localhost:5432/gapsnap

BESTCHANGE_API_KEY=
BESTCHANGE_API_BASE=https://bestchange.app
# Интервал проверки новых кодов BestChange (по умолчанию 12ч).
# Новые валюты/города/страны только в очередь модерации, не в каталог автоматически.
# CATALOG_SYNC_INTERVAL_MS=43200000

# Обязательно смените в production
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
SESSION_SECRET=change-me-to-at-least-24-random-chars
# Email для алертов (баннер не найден на сайте обменника и т.п.)
ADMIN_ALERT_EMAIL=admin@gapsnap.org
# Интервал проверки баннеров на сайтах обменников (по умолчанию 24ч)
# BANNER_CHECK_INTERVAL_MS=86400000
# Секретный URL админки (не /trulala). Не указывайте его в robots.txt.
# ADMIN_PATH=/ops-k7m2xq

# Публичный URL сайта (для ссылок в письмах)
SITE_URL=https://gapsnap.org

# codex.sale — AI-рерайт новостей для /blog
CODEX_API_KEY=
# или CODEX_LB_API_KEY=
CODEX_API_BASE=https://codex.sale/v1
# Super-Proxy (HTTP/HTTPS) — ротация IP при 429
CODEX_PROXY_USER=
CODEX_PROXY_PASS=
CODEX_PROXY_PORT=7165
CODEX_PROXY_LIST_URL=https://super-proxy.net/ruip.html
# Или фиксированный список IP через запятую:
# CODEX_PROXY_HOSTS=185.66.12.4,185.39.148.130
# NEWS_SYNC_INTERVAL_MS=86400000
# NEWS_SYNC_CONCURRENCY=1

# smtp.bz — подтверждение отзывов по email
# Ключ: кабинет smtp.bz → Мой профиль
SMTPBZ_API_KEY=
SMTPBZ_FROM=noreply@gapsnap.org
SMTPBZ_FROM_NAME=GapSnap

# Application DoS limits (requests per IP per minute)
RATE_LIMIT_API_PER_MIN=180
RATE_LIMIT_AUTH_PER_MIN=8
RATE_LIMIT_WRITE_PER_MIN=12
RATE_LIMIT_TRACK_PER_MIN=90
RATE_LIMIT_SEARCH_PER_MIN=40
RATE_LIMIT_SYNC_PER_MIN=4
